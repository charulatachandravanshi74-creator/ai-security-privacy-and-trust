# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Listening port (default 3000)
PORT=3000

# DATABASE_URL: Optional PostgreSQL connection URL.
# If omitted, TrustShield uses an embedded high-performance SQL persistence store.
DATABASE_URL="postgresql://username:password@localhost:5432/trustshield_db"

# JWT_SECRET: Secret for signing JWT authentication tokens.
JWT_SECRET="trustshield_enterprise_super_secret_jwt_key_2026"
